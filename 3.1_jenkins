jenkins tool
1      create a new item netflix pipeline -- goto pipeline script & click pipelin syntax then select git paste git code -save apply then click on build now
2      

pipeline - stage 1 & stage 2
-----------------------------
pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    stages {
        stage('clone the code') {
            steps {
                git 'https://github.com/vipulraghupatruni/Netflix-Pipeline-Project.git'
            }
        }

        stage('Maven Build') {
            steps {
                script {
                    def mavenHome = tool name: 'maven3', type: 'maven'
                    def mavenCMD = "${mavenHome}/bin/mvn"
                    // Run Maven build with parallel execution and skip tests if needed
                    sh "${mavenCMD} clean package -T 1C -DskipTests"
                }
            }
        }
    }

    post {
        always {
            echo 'cleaning up after build...'
            cleanWs() // clean workspace after build
        }
    }
}


