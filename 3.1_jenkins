or

#!/bin/bash

# 1. Install Java 21 and extraction tools
# Note: For Amazon Linux 2023, 'amazon-linux-extras' is replaced by 'dnf'
if command -v dnf &> /dev/null; then
    sudo dnf install -y java-21-amazon-corretto wget unzip
else
    # Fallback for Amazon Linux 2 (if java 21 is available, otherwise uses 17)
    sudo amazon-linux-extras install java-openjdk11 -y || sudo yum install -y java-17-amazon-corretto wget unzip
fi

# 2. Navigate to installation directory
cd /opt/

# 3. Download using the correct DIRECT link format
sudo wget https://binaries.sonarsource.com/Distribution/sonarqube/sonarqube-25.12.0.117093.zip

# 4. Extract package and clean up zip file
sudo unzip sonarqube-25.12.0.117093.zip


# 5. Create the dedicated service user safely
if ! id "sonar" &>/dev/null; then
    sudo useradd sonar
fi


# 6. Apply secure, proper ownership permissions
sudo chown -R sonar:sonar /opt/sonarqube-25.12.0.117093
sudo chmod -R 755 /opt/sonarqube-25.12.0.117093

# 7. Switch to the sonar user environment
echo "SonarQube setup complete. Switching environment to 'sonar' user..."
sudo su - sonar

