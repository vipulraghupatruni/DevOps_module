pipeline stages 
================
pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    stages {
        stage('clone the code') {
            steps {
                git 'https://github.com/vipulraghupatruni/Netflix-Pipeline-Project.git'
            }
        }

        stage('Maven Build') {
            steps {
                script {
                    def mavenHome = tool name: 'maven3', type: 'maven'
                    def mavenCMD = "${mavenHome}/bin/mvn"
                    // Run Maven build with parallel execution and skip tests if needed
                    sh "${mavenCMD} clean package -T 1C -DskipTests"
                }
            }
        }

        stage('Deploy Stage') {
            steps {
                script {
                    // Ensure target directory exists before deploying
                    sh 'ls -l target'
                    // Deploy the WAR file to Tomcat
                    sh 'sudo cp target/NETFLIX-1.2.4.war /home/ec2-user/apache-tomcat-10.1.60/webapps'
                }
            }
        }
    }

    post {
        always {
            echo 'cleaning up after build...'
            cleanWs() // clean workspace after build
        }
    }
}

----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
Jenkins + GitHub + Maven + Nexus + SonarQube + Tomcat + S3 -Pipeline Project
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
jenkins - CI & CD Process
git & github - source code of the application
maven - build the project (generating the war file)
nexus - to store the artifacts (war/jar file)
S3 - to store the artifacts in S3 bucket
SonrQube - code quality analysis
tomcat - deployment of applications

