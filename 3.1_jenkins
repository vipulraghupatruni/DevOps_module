install jenkins
======================

dnf install java-21-amazon-corretto-headless maven -y                       (java/maven)


# 1. Delete the broken file containing the HTML text
sudo rm -f /etc/yum.repos.d/jenkins.repo

# 2. Download the actual repository configuration file
sudo wget -O /etc/yum.repos.d/jenkins.repo \
  https://jenkins.io

# 3. Import the official verification key
sudo rpm --import https://jenkins.io

#after installations
sudo dnf install jenkins -y

sudo systemctl enable --now jenkins
sudo cat /var/lib/jenkins/secrets/initialAdminPassword

