---------------------------------------          sonarqube setup- -------------------------------------------------
cd /opt/
wget https://binaries.sonarsource.com/?prefix=Distribution/sonarqube/sonarqube-25.12.0.117093.zip
unzip sonarqube-25.12.0.117093.zip
amazon-linux-extras install java-openjdk21 -y
